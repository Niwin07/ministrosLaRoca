# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA commitees .env.local (ya está en .gitignore) ni pegues valores
# reales en la documentación del repo.

# ── Auth (NextAuth v5) ─────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Opcional — solo necesario en producción si el dominio no se autodetecta.
# AUTH_URL=https://tu-dominio.com

# ── Base de datos MySQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ministros

# "true" o "require" si el proveedor cloud (Aiven, PlanetScale, etc.) exige
# conexión cifrada. Vacío/ausente = sin SSL (uso típico en local).
DB_SSL=

# ── Notificaciones push (Web Push / VAPID) ──────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# Si falta cualquiera de las tres, el envío de push queda deshabilitado en
# silencio (lib/notif.ts) — las notificaciones igual se guardan en la base,
# solo no llegan como push al dispositivo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# ── IA para importar canciones (opcional) ───────────────────────────────────
# Sin esta clave, /api/ai/interpretar-cancion responde 500 — el resto de la
# app funciona igual, solo se pierde la asistencia de IA al sugerir canciones.
GROQ_API_KEY=
